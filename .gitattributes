# Windows scripts must reach Windows with Windows line endings, whatever
# machine they were committed from.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Everything else: normalise to LF in the repo.
*.rs   text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.css  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.toml text eol=lf
*.js   text eol=lf
*.html text eol=lf

*.png   binary
*.ico   binary
*.icns  binary
*.otf   binary
*.woff2 binary
